CONTEXT_DEV_API_KEY=
GEMINI_API_KEY=                 # Google AI Studio: grouping + fast extraction (LLM_PROVIDER, GEMINI_MODEL)
ANTHROPIC_API_KEY=              # optional: Claude as automatic fallback (LLM_FALLBACK=0 to disable)
ELEVENLABS_API_KEY=             # optional: spoken bulletins (Text to Speech permission is enough)
TIGER_DATABASE_URL=             # optional: history in Tiger Data, postgres://...?sslmode=require
# Public URL of data/sites/ printed by ./serve.sh (Context.dev scrapes this)
SITE_PUBLIC_URL=
# Optional
# SITE_LOCAL_URL=http://127.0.0.1:8765
# CREDIT_BUDGET=1500
# LLM_PROVIDER=gemini            # or anthropic
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROUPING_MODEL=claude-haiku-5-5
# CONTEXT_MAX_CONCURRENT=4        # Context.dev captures in flight at once
# CONTEXT_MONITOR_LIMIT=10       # Context.dev plan's monitor allowance
